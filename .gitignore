.claude/settings.local.json
.claude/stopslop-history.log
.claude/*-memory.md
.claude/stopslop-integrity.json
.claude/stopslop-dashboard.lock
.claude/stopslop-dashboard.log
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Pre-refactor filenames, kept ignored too: a clone that hasn't run the
# one-time migration yet (see core/history.py, integrity_check.py) still
# has these on disk until the first session start / gate event renames them.
.claude/ste100-history.log
.claude/ste100-integrity.json

# Model droppings. An agentic generator writes files where it is
# started; runs are sandboxed now, but a stray module in the repo root
# is never this project.
/*.py
!/stopslop.py
